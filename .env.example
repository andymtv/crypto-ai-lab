# Copy to .env and adjust per machine.

# Memory cap for the API container (jobs run inside it).
API_MEM_LIMIT=6g
# First month to process (downloads always fetch everything published).
# A small slice for low-memory machines, e.g. 2026-04; everything: 2017-01.
LAB_HISTORY_START=2017-01
# Training threads; 0 = all CPU cores.
LAB_THREADS=0

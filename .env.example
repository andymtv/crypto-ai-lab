# Copy to .env and adjust per machine.

# Memory cap for the API container (jobs run inside it).
API_MEM_LIMIT=6g
# First month to process (downloads always fetch everything from 2020-08).
# A small slice for low-memory machines, e.g. 2025-07; full history: 2020-08.
LAB_HISTORY_START=2020-08
# Training threads; 0 = all CPU cores.
LAB_THREADS=0
